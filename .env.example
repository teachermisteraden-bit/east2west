# Admin session signing. Without it, sessions are signed with a per-boot key and
# do not survive a restart. Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Rate limiting. Salts the hashed IP so the stored counter cannot be reversed.
# Generate with: openssl rand -hex 16
RATE_LIMIT_SALT=
